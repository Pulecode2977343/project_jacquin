# ============================================
# JACQUIN API - Local Development Configuration
# ============================================

# Habilitar RewriteEngine
RewriteEngine On

# ============================================
# SEGURIDAD BÁSICA (Evitar acceso directo a config/vendor)
# ============================================

# Proteger archivos sensibles
<FilesMatch "\.(env|json|sql|md|gitignore|bak|log|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Proteger directorios del sistema, pero permitir acceso a assets si es necesario
RewriteRule ^(config|vendor|controllers|models|helpers|middleware)/ - [F,L]

# Prevenir listado de directorios
Options -Indexes

# ============================================
# CORS (Permisivo para desarrollo local en múltiples puertos)
# ============================================
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

# Responder a preflight OPTIONS
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# ============================================
# CONFIGURACIÓN PHP (Modo Desarrollo)
# ============================================
<IfModule mod_php.c>
    # Mostrar errores en pantalla para depuración fácil
    php_flag display_errors On
    php_flag log_errors On
    # Aumentar límites para pruebas locales
    php_value max_execution_time 120
    php_value upload_max_filesize 50M
    php_value post_max_size 50M
</IfModule>
